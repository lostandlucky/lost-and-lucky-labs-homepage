{
  "name": "lost-and-lucky-labs-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "admin",
    "scripts"
  ],
  "scripts": {
    "dev": "concurrently -n server,client,admin -c blue,green,magenta \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:admin\"",
    "dev:client": "npm -w client run dev",
    "dev:server": "npm -w server run dev",
    "dev:admin": "npm -w admin run dev",
    "build": "npm -w client run build && npm -w admin run build",
    "start": "npm -w server run start",
    "setup": "node scripts/setup.js",
    "scrape-images": "node scripts/scrape-images.js",
    "seed": "node scripts/seed-database.js",
    "test": "npm run test:server && npm run test:client && npm run test:admin && npm run test:scripts",
    "test:server": "npm -w server run test",
    "test:client": "npm -w client run test",
    "test:admin": "npm -w admin run test",
    "test:scripts": "npm -w scripts run test",
    "test:visual": "npm -w scripts run test:visual",
    "test:watch": "npx vitest --watch"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
